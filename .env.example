:root {
  --bg: #f4f6f8;
  --panel: #ffffff;
  --panel-alt: #eef3f8;
  --ink: #11212e;
  --muted: #637381;
  --line: #dfe7ef;
  --primary: #1d5cff;
  --primary-soft: rgba(29, 92, 255, 0.12);
  --accent: #0c7a66;
  --shadow: 0 20px 45px rgba(17, 33, 46, 0.08);
}

* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  height: 100%;
  font-family: 'Manrope', sans-serif;
  background: var(--bg);
  color: var(--ink);
}

body {
  min-height: 100vh;
}

button, input, select {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  display: flex;
  min-height: 100vh;
}

.sidebar {
  width: 260px;
  padding: 24px 18px;
  border-right: 1px solid var(--line);
  background: linear-gradient(180deg, #091b2d 0%, #10233b 140%);
  color: white;
  display: flex;
  flex-direction: column;
  gap: 22px;
}

.brand-block {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px 8px 18px;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border-radius: 12px;
  font-weight: 800;
  background: linear-gradient(135deg, #7dd3fc, #5b7cff);
  color: white;
}

.brand-mark.large {
  width: 66px;
  height: 66px;
  font-size: 2rem;
  margin: 0 auto 10px;
}

.eyebrow {
  margin: 0;
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  opacity: 0.72;
}

.brand-block h1,
.page-header h2,
.card h3,
.archive-card h3 {
  margin: 0;
}

.nav {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.nav-link {
  padding: 12px 14px;
  border-radius: 12px;
  color: rgba(255, 255, 255, 0.7);
  text-decoration: none;
  font-weight: 700;
  transition: all 0.2s ease;
}

.nav-link.active,
.nav-link:hover {
  background: rgba(255, 255, 255, 0.08);
  color: white;
}

.logout-button {
  margin-top: auto;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 12px;
  padding: 10px 14px;
  color: white;
  font-weight: 700;
}

.content-panel {
  flex: 1;
  padding: 28px;
}

.page {
  display: flex;
  flex-direction: column;
  gap: 22px;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.upload-box {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12px 18px;
  border-radius: 12px;
  background: var(--primary);
  color: white;
  font-weight: 700;
  overflow: hidden;
}

.upload-box input {
  position: absolute;
  inset: 0;
  opacity: 0;
  cursor: pointer;
}

.filters-panel {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 16px;
  box-shadow: var(--shadow);
}

.filters-panel select,
.filters-panel input,
.login-form input,
.rate-field input {
  width: 200px;
  max-width: 100%;
  border: 1px solid var(--line);
  background: #f8fafc;
  border-radius: 12px;
  padding: 11px 12px;
  color: var(--ink);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 14px;
}

.stat-card {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 18px 20px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  box-shadow: var(--shadow);
}

.stat-card span {
  color: var(--muted);
  font-size: 0.82rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.stat-card strong {
  font-size: clamp(1.5rem, 2vw, 2.1rem);
}

.stat-card.tone-primary {
  background: linear-gradient(135deg, var(--primary-soft), #fff);
  border-color: rgba(29, 92, 255, 0.22);
}

.table-wrap {
  overflow: auto;
  background: var(--panel);
  border-radius: 18px;
  border: 1px solid var(--line);
  box-shadow: var(--shadow);
}

table {
  width: 100%;
  border-collapse: collapse;
  min-width: 760px;
}

th, td {
  padding: 14px 16px;
  border-bottom: 1px solid var(--line);
  text-align: left;
}

th {
  color: var(--muted);
  background: #f9fbfd;
  font-size: 0.75rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

tbody tr:hover {
  background: rgba(29, 92, 255, 0.03);
}

.empty-state {
  background: var(--panel);
  color: var(--muted);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 28px 20px;
  text-align: center;
  box-shadow: var(--shadow);
}

.report-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 20px;
}

.card {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 22px;
  box-shadow: var(--shadow);
}

.bars {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.bar-row {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.bar-meta {
  display: flex;
  justify-content: space-between;
  gap: 12px;
}

.bar-track {
  width: 100%;
  background: #edf2f7;
  height: 10px;
  border-radius: 999px;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #4f8bff, #2846ff);
  border-radius: inherit;
}

.bar-fill.secondary {
  background: linear-gradient(90deg, #52c4a3, #0f997b);
}

.archive-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 18px;
}

.archive-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 18px 20px;
  box-shadow: var(--shadow);
}

.archive-stats {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
  color: var(--muted);
}

.settings-card {
  max-width: 720px;
}

.rate-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 14px;
}

.rate-field {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: var(--muted);
  font-weight: 600;
}

.login-page {
  min-height: 100vh;
  display: grid;
  place-items: center;
  background: radial-gradient(circle at top, rgba(91, 124, 255, 0.18), transparent 30%), #f4f6f8;
}

.login-card {
  width: min(420px, calc(100vw - 32px));
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid var(--line);
  border-radius: 24px;
  padding: 30px 24px;
  box-shadow: var(--shadow);
  text-align: center;
}

.login-card h1 {
  margin: 0 0 12px;
}

.login-card p {
  margin: 0 0 20px;
  color: var(--muted);
}

.login-form {
  display: flex;
  flex-direction: column;
  gap: 16px;
  text-align: left;
}

.login-form label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-weight: 700;
  color: var(--muted);
}

.primary-button {
  border: none;
  border-radius: 12px;
  padding: 12px 16px;
  background: linear-gradient(135deg, var(--primary), #4a7bff);
  color: white;
  font-weight: 800;
}

.error-box {
  padding: 10px 12px;
  border-radius: 10px;
  background: #fff1f2;
  border: 1px solid #fecdd3;
  color: #be123c;
  font-size: 0.92rem;
}

@media (max-width: 900px) {
  .app-shell {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
    border-right: none;
    border-bottom: 1px solid var(--line);
  }

  .content-panel {
    padding: 20px 16px 30px;
  }

  .page-header {
    flex-direction: column;
    align-items: flex-start;
  }

  .filters-panel select,
  .filters-panel input {
    flex: 1 1 100%;
    width: 100%;
  }
}
